WARDEN_API_URL=http://127.0.0.1:8106
# The console key provisioned by `make seed` (WARDEN_CONSOLE_API_KEY in ../.env).
# Never the bootstrap admin key: the console cannot and should not manage API keys.
WARDEN_API_KEY=wdn_console1_local-dev-only-change-me
WORKSPACES_API_URL=http://127.0.0.1:27106
# Optional HTTP basic auth for the console, as user:password. Required when the
# console listens on anything other than localhost.
CONSOLE_BASIC_AUTH=
