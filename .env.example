# Local development values. They are placeholders: anything that is not local must
# use fresh keys, e.g. `echo "wdn_$(openssl rand -hex 4)_$(openssl rand -hex 24)"`.
# With WARDEN_ENV=production the API refuses a bootstrap key that contains "change-me".

# Warden API
WARDEN_ENV=development
WARDEN_HOST=127.0.0.1
WARDEN_PORT=8106
WARDEN_DATABASE_URL=postgresql+asyncpg://warden:warden@127.0.0.1:5506/warden
WARDEN_CACHE_BACKEND=memory
WARDEN_REDIS_URL=redis://127.0.0.1:6406/0
WARDEN_REVISION_QUANTIZATION_MS=2000
WARDEN_DECISION_LOG=async
WARDEN_TUPLE_HISTORY_RETENTION_HOURS=24
WARDEN_DECISION_RETENTION_DAYS=30
WARDEN_QUERY_DEADLINE_MS=10000
WARDEN_BOOTSTRAP_ADMIN_KEY=wdn_bootstrap_local-dev-only-change-me
# Provisioned by `make seed` with every scope except keys:admin; the console uses it.
WARDEN_CONSOLE_API_KEY=wdn_console1_local-dev-only-change-me
WARDEN_CORS_ORIGINS=["http://localhost:3106"]
WARDEN_LOG_JSON=false

# Workspaces demo app (port 27106 is the slot otherwise reserved for Mongo, which this project does not use)
WORKSPACES_PORT=27106
WORKSPACES_DATABASE_URL=postgresql+asyncpg://warden:warden@127.0.0.1:5506/warden
WORKSPACES_WARDEN_URL=http://127.0.0.1:8106
WORKSPACES_WARDEN_API_KEY=wdn_demoapp1_local-dev-only-change-me
WORKSPACES_WARDEN_STORE_ID=st_workspaces_demo
